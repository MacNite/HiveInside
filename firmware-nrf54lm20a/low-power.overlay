/* Deployment profile — apply together with low-power.conf; see
 * docs/low-power.md.
 *
 * uart20 is useful during bring-up but is unnecessary in a sealed beacon.
 * Disabling the node keeps the peripheral unconfigured and leaves its pins in
 * the reset (disconnected) state. app.overlay still names uart20 as
 * zephyr,console, but with CONFIG_UART_CONSOLE=n nothing resolves that chosen
 * node, so a disabled console node is harmless here. */
&uart20 {
	status = "disabled";
};

/* The fresh-measurement blink is diagnostic only, so drop it from a deployment
 * image. This is a behaviour change, not a power optimisation: the LED is
 * active-low and main.c already drives the pin inactive, so a disabled node
 * saves only the 100 ms blink itself — about 0.03 % duty at the default
 * five-minute interval. main.c compiles the blink out via the led0 alias
 * status check, so nothing else has to change. */
&blue_led {
	status = "disabled";
};

/* The external 8 MB SPI NOR is not used by the measurement beacon or MCUboot's
 * fixed on-chip RRAM slots. Seeed's System OFF example calls out the flash as a
 * leakage source unless it is explicitly put into deep power-down and its SPI
 * pins are held in known states. The always-advertising profile does not enter
 * System OFF, so the safest app-level saving is simpler: keep the flash driver
 * from initialising this unused part at all. */
&py25q64 {
	status = "disabled";
};

/* Production nodes do not need the nPM1300 LED engine. The charger/fuel-gauge
 * and regulator functions stay enabled through the PMIC MFD; only the optional
 * LED child device is suppressed to avoid any autonomous LED current. */
&pmic_leds {
	status = "disabled";
};

/* The Sense IMU/microphone island is enabled explicitly by src/power.c for each
 * measurement cycle. Do not let the board DTS keep that upstream GPIO gate on
 * before main() runs or after the first cycle has completed. */
&power_en {
	/delete-property/ regulator-boot-on;
};

/* Likewise, LDO1 is brought up to 3.3 V at runtime immediately before the IMU
 * and PDM microphone are sampled, then disabled again between cycles. */
&pmic {
	regulators {
		LDO1 {
			/delete-property/ regulator-boot-on;
		};
	};
};
