/*
 * app.overlay — HiveInside adjustments to the XIAO nRF54LM20A board DT.
 *
 * Zephyr includes this automatically for every build configuration; the
 * low-power deployment image layers low-power.overlay on top of it through
 * EXTRA_DTC_OVERLAY_FILE. See docs/vscode-build.md.
 *
 * Everything else the firmware needs is already enabled by the upstream board
 * definition: i2c22 (the XIAO header bus, external SHT40), i2c30 (internal bus
 * with the LSM6DS3TR-C at 0x6a) and the nPM1300 charger/regulator nodes.
 */
#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	chosen {
		/* Console routing.
		 *
		 * uart20 (P1.11 TX / P1.10 RX) is wired to the on-board SAMD11
		 * CMSIS-DAP debugger, which bridges it to a USB CDC ACM port
		 * (/dev/ttyACM0) over the same USB-C cable used for flashing.
		 * The board definition already chooses uart20; re-assert it here
		 * so the application console does not silently move if a future
		 * board-definition bump changes the default. The XIAO header
		 * UART is uart21 on D6/D7 — deliberately NOT the console. */
		zephyr,console = &uart20;
		zephyr,shell-uart = &uart20;
	};
};

/* Belt-and-suspenders: the board definition already enables uart20 at
 * 115200 8N1; keep it explicit next to the console choice above. */
&uart20 {
	status = "okay";
	current-speed = <115200>;
};

/* nPM1300 PMIC bit-banged I2C — pin correction.
 *
 * The board DTS routes the PMIC's bit-banged I2C to P1.15 (SDA) / P1.16 (SCL),
 * but the actual XIAO nRF54LM20A Sense hardware wires the nPM1300 to
 * P1.18 (SDA) / P1.17 (SCL). Without this override the firmware talks to the
 * wrong pins, the nPM1300 is unreachable, and LDO1 stays at its 1.8 V default —
 * enough for the LSM6DS3TR-C IMU (on the separate i2c30 bus) but too low for
 * the MSM261DGT006 microphone, whose PDM capture then returns no data. Matches
 * Seeed's own on-board-sensor reference overlay. */
&pmic_i2c {
	sda-gpios = <&gpio1 18 GPIO_ACTIVE_HIGH>;
	scl-gpios = <&gpio1 17 GPIO_ACTIVE_HIGH>;
	status = "okay";
};

/* Free the peripheral slot the PDM shares with PWM.
 *
 * On the nRF54L the "20" peripheral group multiplexes pdm20 and pwm20 onto the
 * same underlying block/pins, so only one can run at a time. The board enables
 * pwm20 by default, which leaves pdm20 able to be configured and "started" yet
 * never actually sampling — dmic_read() then times out with zero DMA blocks
 * ("read stopped after 0 frames"). Disabling pwm20 releases the slot to the
 * microphone. (Per Seeed's working on-board-mic overlay.) */
&pwm20 {
	status = "disabled";
};

/* On-board PDM microphone (MSM261DGT006). The board definition provides
 * pinctrl (P1.13 CLK / P1.14 DIN) and clock-source but leaves the controller
 * disabled. */
&pdm20 {
	status = "okay";
};

/* The Sense module powers the PDM microphone (and, on this board, the IMU) from
 * the nPM1300's LDO1. The board default is 1.8 V; the microphone needs 3.3 V.
 * Keep the rail at 3.3 V and enable it at boot so it is already correct before
 * any code runs; src/power.c then re-asserts 3.3 V and waits for the parts to
 * settle. regulator-init-microvolt makes the rail correct even if power.c is
 * ever compiled out. This only takes effect once &pmic_i2c above can actually
 * reach the nPM1300. */
&pmic {
	regulators {
		LDO1 {
			regulator-min-microvolt = <3300000>;
			regulator-max-microvolt = <3300000>;
			regulator-init-microvolt = <3300000>;
			regulator-boot-on;
		};
	};
};

/* Watchdog for unattended operation (src/watchdog.c).
 *
 * Both nRF54LM20A watchdog instances ship disabled in the SoC devicetree.
 * wdt31 is chosen over wdt30 because wdt30 is compiled out of the SoC
 * devicetree entirely under a non-secure address map, so wdt31 is the instance
 * that exists in every build variant. */
&wdt31 {
	status = "okay";
};
